# backend/.env のテンプレート。backend/.env にコピーし、CHANGE_ME と空欄を各自の値に置き換える。
# backend/.env はコミットしない（.gitignore 済み）。

# DB（docker compose の db コンテナもこの値で初期化される）。パスワードは推測されにくい値にする
#   生成例: openssl rand -base64 24
POSTGRES_DB=sns_db
POSTGRES_USER=sns_user
POSTGRES_PASSWORD=CHANGE_ME
DATABASE_URL=postgres://sns_user:CHANGE_ME@db:5432/sns_db?sslmode=disable

# JWT の署名鍵。32 文字以上のランダムな値を、アクセス用とリフレッシュ用で別々に生成する（未設定・短い・同じ値だと起動しない）
#   生成例: openssl rand -base64 48
JWT_SECRET=
JWT_REFRESH_SECRET=

FIREBASE_CREDENTIALS_JSON={}
CORS_ORIGINS=http://localhost:5173
PORT=8080
ENV=development

# ------------------------------------------------------------
# 管理画面（http://localhost:8080/admin）。詳細は docs/admin-panel.md
# ------------------------------------------------------------
# セッション Cookie の署名鍵。空欄のままだと管理画面は無効（/admin は 404）。
# 32 文字以上で JWT_SECRET / JWT_REFRESH_SECRET と別の値にする。生成例: openssl rand -base64 48
ADMIN_SESSION_SECRET=
# ルート管理者のログイン情報（admins テーブルには保存しない）。パスワードは 12 文字以上
ADMIN_ROOT_USERNAME=root
ADMIN_ROOT_PASSWORD=
# パスワードリセットリンクのURLに使うフロントエンドのURL（未設定時は CORS_ORIGINS の先頭）
FRONTEND_BASE_URL=http://localhost:5173
# パスワードリセットリンクの有効期限（分）。既定 1440（24 時間）、10〜10080
PASSWORD_RESET_TOKEN_TTL_MINUTES=1440

# 新規登録ユーザーの自動承認（E2E テスト専用）。ENV=test 以外では設定しても無視される。開発・本番では設定しないこと
# AUTO_APPROVE_USERS=false
