# テスト環境専用の設定。開発環境（backend/.env）とは完全に分離されている。
# 秘密情報は含まないためコミットしてよい。
POSTGRES_DB=sns_test_db
POSTGRES_USER=sns_test_user
POSTGRES_PASSWORD=sns_test_password
DATABASE_URL=postgres://sns_test_user:sns_test_password@db_test:5432/sns_test_db?sslmode=disable
JWT_SECRET=test_jwt_secret_for_local_testing_only_32bytes
JWT_REFRESH_SECRET=test_jwt_refresh_secret_for_local_testing_32bytes
FIREBASE_CREDENTIALS_JSON={}
FIREBASE_STORAGE_BUCKET=
CORS_ORIGINS=http://localhost:5174,http://localhost:5173
PORT=8080
ENV=test
