# E2Eテスト用の環境変数。テスト用APIサーバー（api_test / :8081）に向ける。
VITE_API_BASE_URL=http://localhost:8081/api/v1

# E2EではGoogleログインを使わないためダミー値でよい（Firebase SDKの初期化のみ通す）
VITE_FIREBASE_API_KEY=e2e-dummy-api-key
VITE_FIREBASE_AUTH_DOMAIN=e2e-dummy.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=e2e-dummy
VITE_FIREBASE_STORAGE_BUCKET=e2e-dummy.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:e2edummy
