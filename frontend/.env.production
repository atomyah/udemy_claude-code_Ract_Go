# 本番ビルド（vite build / npm run build）用の環境変数。docs/deploy.md の「7.2 フロントエンド」を参照。
# VITE_ で始まる値はビルド時に JS に埋め込まれ、誰でも閲覧できる。秘密情報（サービスアカウント・JWT 鍵など）は絶対に書かない。
# Vite の優先順位は .env.production.local > .env.production > .env.local なので、開発用 .env.local の値は本番ビルドに混ざらない。

# Cloud Run のバックエンド URL（末尾に /api/v1）。初回デプロイ後に Cloud Run の URL へ置き換える
VITE_API_BASE_URL=https://udemy-claude-code-ract-go-git-807947910925.asia-northeast1.run.app/api/v1

# Firebase Web アプリの設定（Firebase コンソール > プロジェクトの設定 > マイアプリ）。公開前提の値で秘密情報ではない
VITE_FIREBASE_API_KEY=AIzaSyAgbVEZB3en1CFizqdCpgQ1W8JPUG_8paQ
VITE_FIREBASE_AUTH_DOMAIN=udemy-claudecode-react-go.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=udemy-claudecode-react-go
VITE_FIREBASE_STORAGE_BUCKET=udemy-claudecode-react-go.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=807947910925
VITE_FIREBASE_APP_ID=1:807947910925:web:8acf548f6c0190550afa44
